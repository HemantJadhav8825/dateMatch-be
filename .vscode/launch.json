{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Start Gateway and Services",
      "configurations": ["Gateway", "Call Service", "Match Service", "Payment Service", "User Service"]
    }
  ],
  "configurations": [
    {
      "name": "Gateway",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/gateway/index.js",
      "runtimeExecutable": "nodemon",
      "port": 9229
    },
    {
      "name": "Call Service",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/services/call-service/index.js",
      "runtimeExecutable": "nodemon",
      "port": 9230
    },
    {
      "name": "Match Service",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/services/match-service/index.js",
      "runtimeExecutable": "nodemon",
      "port": 9231
    },
    {
      "name": "Payment Service",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/services/payment-service/index.js",
      "runtimeExecutable": "nodemon",
      "port": 9232
    },
    {
      "name": "User Service",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/services/user-service/index.js",
      "runtimeExecutable": "nodemon",
      "port": 9233
    }
  ]
}
